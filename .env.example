APP_RUNTIME_MODE=dev

# Shared infrastructure
POSTGRES_DB=ppaob
POSTGRES_USER=ppaob
POSTGRES_PASSWORD=ppaob_dev_password
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ppaob
DB_USER=ppaob
DB_PASSWORD=ppaob_dev_password

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev_password
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_dev_password
S3_BUCKET=ppaob-binaries
S3_PATH_STYLE=true

# Backend
PORT=8080
DB_URL=jdbc:postgresql://postgres:5432/ppaob
JWT_SECRET=change-this-in-production-change-this-in-production
JWT_TTL_MINUTES=15
REFRESH_TTL_DAYS=14
REFRESH_COOKIE_NAME=ppaob_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=Lax
REFRESH_COOKIE_PATH=/api/v1/auth
MAX_UPLOAD_FILE_SIZE=20MB
MAX_UPLOAD_REQUEST_SIZE=20MB
APP_UPLOAD_MAX_BYTES=20971520
APP_AUDIT_SYSTEM_USER_EMAIL=system@ppaob.local
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend
VITE_API_URL=http://localhost:8080/api/v1

# Workers (shared)
WORKER_POLL_SECONDS=3
WORKER_LOG_LEVEL=INFO
APP_CORRELATION_ENV_PROFILE=LINUX_SERVER
APP_CORRELATION_OBSERVED_RUNS=1
APP_DEPLOYMENT_EXPOSURE=INTERNAL
APP_DEPLOYMENT_PRIVILEGE_LEVEL=USER
APP_DEPLOYMENT_DATA_SENSITIVITY=MEDIUM

# Dynamic worker
WORKER_PROFILE=DYNAMIC_BASELINE
DYNAMIC_AGENT_TIMEOUT_MS=5000
DYNAMIC_AGENT_PATH=/opt/agent-dynamic-c/agent_dynamic
